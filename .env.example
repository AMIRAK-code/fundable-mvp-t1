# ─────────────────────────────────────────────────────────────
# Fundable — environment variables
# Copy to `.env.local` for local dev and fill in real values.
# In production (Vercel), set these in Project → Settings → Environment Variables.
# NEVER commit real secrets. `.env.local` is gitignored.
# ─────────────────────────────────────────────────────────────

# --- Supabase (Project → Settings → API) ---
# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret — bypasses RLS. Used by push delivery, the cached feed
# data layer, the admin dashboard, and logEvent. DO NOT prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# --- App origin ---
# Used for OAuth / magic-link / password-reset email redirect targets.
# Local: http://localhost:3000   Prod: https://your-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Web Push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys --json
# `subject` must be a mailto: or https: URL.
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
